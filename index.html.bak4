const MNEMONICS = {"一":["một nét","lines1","1 nét ngang = số một."],"二":["hai nét","lines2","2 nét ngang = số hai."],"三":["ba nét","lines3","3 nét ngang = số ba."],"十":["mười","cross","Một nét dọc cắt nét ngang như dấu thập."],"上":["trên","above","Nét ngắn nằm phía trên đường chuẩn."],"下":["dưới","below","Nét ngắn rơi xuống dưới đường chuẩn."],"中":["giữa","center","Nét dọc xuyên qua khung, nằm ở chính giữa."],"口":["miệng","mouth","Khung vuông giống cái miệng đang mở."],"人":["người","person","Hai nét chụm lại như dáng người đứng."],"大":["lớn","big","Người dang rộng tay nên trông rất lớn."],"小":["nhỏ","small","Một nét chính với hai chấm nhỏ hai bên."],"木":["cây","tree","Thân cây, cành cây và rễ cây."],"林":["rừng","forest2","Hai cây 木 đứng cạnh nhau thành rừng."],"森":["rừng rậm","forest3","Ba cây 木 tụ lại thành rừng dày."],"本":["gốc cây","root","Cây 木 thêm một nét ở gốc."],"休":["nghỉ","rest","Người 人 tựa vào cây 木 để nghỉ."],"日":["mặt trời","sun","Khung tròn xưa của mặt trời được vuông hóa."],"月":["mặt trăng","moon","Dáng vầng trăng khuyết được vuông hóa."],"明":["sáng","sunMoon","Mặt trời 日 cộng mặt trăng 月 thành sáng."],"朋":["bạn","twoMoons","Hai vầng 月 đi cạnh nhau như hai người bạn."],"水":["nước","water","Nét giữa là dòng chính, hai bên là nhánh nước."],"火":["lửa","fire","Các nét tỏa lên như ngọn lửa."],"雨":["mưa","rain","Mái trời bên trên, các chấm là giọt mưa."],"雪":["tuyết","snow","Mưa 雨 rơi xuống thành tuyết."],"山":["núi","mountain","Ba đỉnh nhô lên như dãy núi."],"女":["nữ","woman","Dáng người nữ trong chữ cổ."],"子":["con","child","Dáng một đứa trẻ được cách điệu."],"好":["tốt","womanChild","女 và 子 đứng cạnh nhau, gợi điều tốt lành."],"手":["tay","hand","Các nét xòe ra như bàn tay."],"打":["đánh/gõ","hand","Bộ tay bên trái nhắc hành động bằng tay."],"找":["tìm","hand","Có bộ tay, gợi động tác đưa tay tìm kiếm."],"目":["mắt","eye","Khung chữ giống con mắt nhìn thẳng."],"看":["nhìn","handEye","Bàn tay đặt trên mắt để nhìn xa."],"见":["thấy","eyeLegs","Con mắt có chân: nhìn thấy rồi đi tới."],"心":["tim","heart","Các chấm quanh nét chính gợi nhịp tim/cảm xúc."],"想":["nghĩ","heart","Có 心 ở dưới: việc xảy ra trong lòng/trí."],"门":["cửa","door","Hai nét hai bên như cánh cửa."],"问":["hỏi","doorMouth","Miệng 口 trong cửa 门: đứng cửa hỏi."],"间":["khoảng/phòng","doorSun","Mặt trời 日 lọt qua cửa 门 tạo khoảng sáng."],"车":["xe","vehicle","Khung xe và trục bánh được giản hóa."],"飞":["bay","wing","Các nét như đôi cánh đang bay."],"田":["ruộng","field","Khung ruộng chia thành các ô."],"男":["nam","fieldPower","Ruộng 田 cộng sức 力: người làm ruộng."],"力":["sức","power","Dáng cánh tay dùng lực."],"字":["chữ","roofChild","Đứa trẻ 子 dưới mái nhà: chữ được nuôi dạy."],"家":["nhà","roof","Mái nhà bao phủ không gian sống."],"学":["học","school","Mái lớp học ở trên, trẻ ở dưới."],"校":["trường","school","Cây 木 cạnh hình giao nhau, gợi sân trường."],"书":["sách","book","Các nét xếp như trang sách."],"文":["văn","text","Các nét giao nhau như hoa văn/chữ viết."],"语":["ngôn ngữ","speech","Bộ lời nói bên trái nhắc tới ngôn ngữ."],"话":["lời nói","speech","Bộ lời nói bên trái nhắc tới câu nói."],"说":["nói","speech","Bộ lời nói bên trái nhắc hành động nói."],"请":["mời","speech","Bộ lời nói bên trái: nói lời mời."],"读":["đọc","speech","Bộ lời nói bên trái: đọc thành lời."],"钱":["tiền","money","Bộ kim loại bên trái gợi tiền xu."],"饭":["cơm","bowl","Bộ ăn bên trái gợi bát cơm."],"茶":["trà","tea","Lá cây ở trên, người và cây phía dưới gợi trà."],"电":["điện","lightning","Nét gấp như tia điện đi qua khung."],"高":["cao","tower","Các tầng chồng lên nhau thành nhà cao."],"米":["gạo","rice","Hạt gạo tỏa ra quanh tâm."],"衣":["áo","shirt","Dáng cổ áo và hai vạt áo."],"包":["bao","wrap","Đường cong bao lấy phần bên trong."],"点":["điểm","dots","Các chấm bên dưới như những điểm nhỏ."],"出":["ra","exit","Hai khối nhô ra khỏi miệng hang/cửa."],"开":["mở","open","Hai tay đẩy cửa mở ra."],"正":["đúng","straight","Các nét ngay ngắn, vuông vức."],"不":["không","no","Nét chặn phía trên, nét dưới rẽ đi: phủ định."],"坐":["ngồi","sit","Hai người ngồi trên đất 土."],"早":["sớm","sunrise","Mặt trời 日 ở trên, phía dưới là mốc thời gian."],"星":["sao","star","Mặt trời/ngôi sao 日 ở trên, sinh sáng ở dưới."],"国":["nước/quốc gia","country","Khung lớn bao quanh phần bên trong như biên giới."]};
const todayISO=()=>new Date().toISOString().slice(0,10);
const daysBetween=(a,b)=>Math.floor((new Date(b+"T00:00:00")-new Date(a+"T00:00:00"))/86400000);
let state=load();
let idx=(typeof state._idx==='number')?state._idx:0;
let lessonOrder=Array.isArray(state._lessonOrder)?state._lessonOrder:[];
delete state._idx; delete state._lessonOrder;
let flipped=false, autoSound=true, autoPlay=false, autoPlayTimer=0, currentMode="today", selectedHistoryDate='', preferredVoice=null, speakTimer=0, filterUnknown=false, studyAllMode=false;
const AUTOPLAY_SHOW_MS=2500, AUTOPLAY_FLIPPED_MS=3000;
function load(){try{const saved=JSON.parse(localStorage.getItem(KEY)||"{}");return {learned:saved.learned||{},today:saved.today||[],reviewLog:saved.reviewLog||{},lessonHistory:saved.lessonHistory||{},srs:saved.srs||{},_idx:(typeof saved.idx==='number')?saved.idx:0,_lessonOrder:Array.isArray(saved.lessonOrder)?saved.lessonOrder:[]}}catch(e){return {learned:{},today:[],reviewLog:{},lessonHistory:{},srs:{},_idx:0,_lessonOrder:[]}}}
function persist(){localStorage.setItem(KEY,JSON.stringify({learned:state.learned,today:state.today,reviewLog:state.reviewLog,lessonHistory:state.lessonHistory,srs:state.srs,idx,lessonOrder}));}
function save(){persist();render();}
function word(id){return VOCAB.find(w=>w.id===id)}
/* ===== Anki SM-2 spaced repetition ===== */
const SRS_MIN_EASE=1.3, SRS_EASY_BONUS=1.3, SRS_HARD_MULT=1.2, SRS_AGAIN_EASE=.20, SRS_HARD_EASE=.15, SRS_EASY_EASE=.15;
function addDaysISO(iso,n){const d=new Date(iso+"T00:00:00");d.setDate(d.getDate()+n);return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;}
function srsPredict(s,q){let ease=s?s.ease:2.5,ivl=s?s.ivl:0,reps=s?s.reps:0,lapses=s?s.lapses:0;
  if(q==='again'){ease=Math.max(SRS_MIN_EASE,ease-SRS_AGAIN_EASE);lapses+=1;reps=0;ivl=0;}
  else if(reps===0){if(q==='hard'||q==='good')ivl=1;else{ivl=4;ease+=SRS_EASY_EASE;}reps=1;}
  else{if(q==='hard'){ease=Math.max(SRS_MIN_EASE,ease-SRS_HARD_EASE);ivl=Math.max(1,Math.round(ivl*SRS_HARD_MULT));}else if(q==='good'){ivl=Math.max(1,Math.round(ivl*ease));}else{ease+=SRS_EASY_EASE;ivl=Math.max(1,Math.round(ivl*ease*SRS_EASY_BONUS));}reps+=1;}
  return {ease,ivl,reps,lapses};}
function fmtIvl(d){if(d<=0)return '<10 phút';if(d<30)return d+' ngày';if(d<365){const m=Math.max(1,Math.round(d/30));return m+' tháng';}return (Math.round(d/36.5)/10)+' năm';}
function isPending(id){const s=state.srs[id];return !s||daysBetween(s.due,todayISO())>=0;} /* new, due today, or overdue */
function isDue(w){const s=state.srs[w.id];return !!s&&daysBetween(s.due,todayISO())>=0;} /* đã học & đến hạn ôn */
function dueIds(){return VOCAB.filter(w=>isDue(w)).map(w=>w.id);}
function shuffleIds(ids){const arr=[...ids];for(let i=arr.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[arr[i],arr[j]]=[arr[j],arr[i]]}return arr}
function resetLessonOrder(){lessonOrder=shuffleIds(state.today)}
function shuffleCards(){if(!state.today.length)return;lessonOrder=shuffleIds(state.today);idx=0;flipped=false;snapFlipReset();renderFlash();animateCard('next');queueSpeak(3000);scheduleAutoPlay();persist();}
function autoPlayDelay(ms,next){autoPlayTimer=setTimeout(()=>{if(!autoPlay||document.hidden)return;next();},ms);}
function scheduleAutoPlay(){clearTimeout(autoPlayTimer);if(!autoPlay||document.hidden)return;if(!flipped){autoPlayDelay(3000,()=>{speak(()=>{if(!autoPlay)return;autoPlayDelay(3000,()=>{flipped=true;renderFlash();autoPlayDelay(3000,()=>{speak(()=>{if(!autoPlay)return;autoPlayDelay(4000,()=>{nextCard();});});});});});});}else{autoPlayDelay(3000,()=>{speak(()=>{if(!autoPlay)return;autoPlayDelay(4000,()=>{nextCard();});});});}}
function toggleAutoPlay(){autoPlay=!autoPlay;if(autoPlay){scheduleAutoPlay();}else{clearTimeout(autoPlayTimer);window.speechSynthesis?.cancel();}updateAudioBtns();}
function updateFilterUnknownBtn(){const b=document.getElementById('btnFilterUnknown');if(!b)return;b.classList.toggle('is-active',studyAllMode);b.title=studyAllMode?'Đang xem TẤT CẢ thẻ trong bài (bấm để chỉ xem thẻ cần ôn)':'Xem tất cả thẻ trong bài (kể cả đã xong hôm nay)';}
function toggleFilterUnknown(){studyAllMode=!studyAllMode;idx=0;flipped=false;renderFlash();updateFilterUnknownBtn();}
function updateAudioBtns(){updateFilterUnknownBtn();const a=document.getElementById('btnAutoSound');if(a){a.innerHTML=autoSound?'<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/></svg>':'<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="22" y1="9" x2="16" y2="15"/><line x1="16" y1="9" x2="22" y2="15"/></svg>';a.classList.toggle('is-active',autoSound);a.title=autoSound?'Tự đọc khi sang thẻ: bật':'Tự đọc khi sang thẻ: tắt';}const p=document.getElementById('btnAutoPlay');if(p){p.innerHTML=autoPlay?'<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>':'<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>';p.classList.toggle('is-active',autoPlay);p.classList.toggle('play',autoPlay);p.title=autoPlay?'Tự chạy thẻ: đang chạy':'Tự chạy thẻ: tắt';}}
function restudyWord(id){delete state.learned[id];delete state.reviewLog[id];delete state.srs[id];if(!state.today.includes(id)){state.today.push(id);resetLessonOrder();}save();}
function lessonIds(){if(lessonOrder.length!==state.today.length||lessonOrder.some(id=>!state.today.includes(id)))resetLessonOrder();return studyAllMode?lessonOrder:lessonOrder.filter(isPending);} function currentWord(){return word(lessonIds()[idx])}
function nextPendingAfter(id){const start=lessonOrder.indexOf(id);for(let k=1;k<=lessonOrder.length;k++){const c=lessonOrder[(start+k)%lessonOrder.length];if(isPending(c))return c;}return isPending(id)?id:null;}
function gradeCard(q){const ids=lessonIds();if(!ids.length)return;const id=ids[idx];const today=todayISO();const ns=srsPredict(state.srs[id],q);state.srs[id]={ease:ns.ease,ivl:ns.ivl,reps:ns.reps,lapses:ns.lapses,due:ns.ivl<=0?today:addDaysISO(today,ns.ivl),last:today};if(!state.learned[id])state.learned[id]=today;state.reviewLog[id]=[...(state.reviewLog[id]||[]),today];snapshotToday();const pend=lessonOrder.filter(isPending);if(!pend.length){flipped=false;idx=0;snapFlipReset();save();return;}const nid=nextPendingAfter(id);idx=Math.max(0,pend.indexOf(nid));flipped=false;snapFlipReset();save();animateCard('next');queueSpeak(3000);scheduleAutoPlay();}
function hanVietText(hanzi){return [...hanzi].filter(ch=>/\p{Script=Han}/u.test(ch)).map(ch=>HAN_VIET[ch]||ch).join(' ')}
function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function mnemonicSvg(kind,ch){const c='#111827',a='#2563eb',g='#16a34a',o='#f59e0b',r='#dc2626';const text=`<text x="44" y="43" text-anchor="middle" font-size="34" font-weight="800" fill="${c}">${esc(ch)}</text>`;const wrap=s=>`<svg class="mnemonic-visual" viewBox="0 0 88 64" aria-hidden="true">${s}</svg>`;const tree=`<path d="M44 12v38M28 36h32M44 20 28 38M44 20l16 18" stroke="${g}" stroke-width="5" stroke-linecap="round" fill="none"/><path d="M30 52h28" stroke="#8b5a2b" stroke-width="5" stroke-linecap="round"/>`;if(kind==='mouth')return wrap(`<rect x="21" y="18" width="46" height="30" rx="14" fill="#fee2e2" stroke="${r}" stroke-width="5"/><path d="M28 34h32" stroke="${r}" stroke-width="4" stroke-linecap="round"/>`);if(kind==='person')return wrap(`<path d="M44 10 28 54M44 10l18 44" stroke="${c}" stroke-width="7" stroke-linecap="round"/>`);if(kind==='big')return wrap(`<path d="M44 10v46M20 28h48M44 30 24 54M44 30l22 24" stroke="${c}" stroke-width="6" stroke-linecap="round"/>`);if(kind==='small')return wrap(`<path d="M44 14v42M28 32l-10 12M60 32l10 12" stroke="${c}" stroke-width="6" stroke-linecap="round"/>`);if(kind==='tree')return wrap(tree);if(kind==='forest2')return wrap(`<g transform="translate(-10 0) scale(.82)">${tree}</g><g transform="translate(24 0) scale(.82)">${tree}</g>`);if(kind==='forest3')return wrap(`<g transform="translate(-15 7) scale(.68)">${tree}</g><g transform="translate(18 7) scale(.68)">${tree}</g><g transform="translate(2 -7) scale(.7)">${tree}</g>`);if(kind==='root')return wrap(`${tree}<path d="M30 46h28" stroke="${r}" stroke-width="5" stroke-linecap="round"/>`);if(kind==='rest')return wrap(`<path d="M24 16 14 54M24 16l12 38" stroke="${c}" stroke-width="5" stroke-linecap="round"/><g transform="translate(28 3) scale(.75)">${tree}</g>`);if(kind==='sun')return wrap(`<circle cx="44" cy="32" r="18" fill="#fde68a" stroke="${o}" stroke-width="5"/><path d="M44 5v8M44 51v8M17 32h8M63 32h8" stroke="${o}" stroke-width="4" stroke-linecap="round"/>`);if(kind==='moon')return wrap(`<path d="M54 10c-18 5-25 31-8 44-22-3-31-31-12-46 6-5 14-5 20 2z" fill="#dbeafe" stroke="${a}" stroke-width="5"/>`);if(kind==='sunMoon')return wrap(`<circle cx="28" cy="32" r="14" fill="#fde68a" stroke="${o}" stroke-width="5"/><path d="M62 14c-14 4-19 27-5 36-17-2-24-25-10-37 5-4 10-3 15 1z" fill="#dbeafe" stroke="${a}" stroke-width="5"/>`);if(kind==='twoMoons')return wrap(`<path d="M36 13c-13 4-18 27-4 38-17-2-23-25-9-37 4-3 9-3 13-1z" fill="#dbeafe" stroke="${a}" stroke-width="4"/><path d="M64 13c-13 4-18 27-4 38-17-2-23-25-9-37 4-3 9-3 13-1z" fill="#dbeafe" stroke="${a}" stroke-width="4"/>`);if(kind==='water')return wrap(`<path d="M44 10v42M30 25c-9 9-10 18-4 28M58 25c9 9 10 18 4 28" stroke="${a}" stroke-width="6" stroke-linecap="round" fill="none"/>`);if(kind==='fire')return wrap(`<path d="M46 8c3 14-10 16-10 30 0 10 8 18 18 18s18-7 18-18c0-9-5-16-13-23 1 12-7 13-13-7z" fill="#fed7aa" stroke="#ea580c" stroke-width="5" stroke-linejoin="round"/>`);if(kind==='rain'||kind==='snow')return wrap(`<path d="M16 18h56M24 18v8h40v-8" stroke="${a}" stroke-width="5" stroke-linecap="round"/><path d="M28 34v12M44 32v16M60 34v12" stroke="${kind==='snow'?'#93c5fd':a}" stroke-width="5" stroke-linecap="round"/><circle cx="28" cy="52" r="3" fill="${kind==='snow'?'#93c5fd':a}"/><circle cx="44" cy="54" r="3" fill="${kind==='snow'?'#93c5fd':a}"/><circle cx="60" cy="52" r="3" fill="${kind==='snow'?'#93c5fd':a}"/>`);if(kind==='mountain')return wrap(`<path d="M12 54 32 18l14 24 10-16 20 28H12z" fill="#dcfce7" stroke="${g}" stroke-width="5" stroke-linejoin="round"/>`);if(kind==='woman')return wrap(`<path d="M44 12c-12 10-16 22-10 38M44 12c12 10 16 22 10 38M27 38h34" stroke="#be185d" stroke-width="5" stroke-linecap="round" fill="none"/>`);if(kind==='child')return wrap(`<circle cx="44" cy="16" r="8" fill="#fde68a" stroke="${o}" stroke-width="4"/><path d="M44 25v24M28 35h32" stroke="${c}" stroke-width="5" stroke-linecap="round"/>`);if(kind==='womanChild')return wrap(`<g transform="translate(-14 2) scale(.8)"><path d="M44 12c-12 10-16 22-10 38M44 12c12 10 16 22 10 38M27 38h34" stroke="#be185d" stroke-width="5" stroke-linecap="round" fill="none"/></g><g transform="translate(24 0) scale(.82)"><circle cx="44" cy="16" r="8" fill="#fde68a" stroke="${o}" stroke-width="4"/><path d="M44 25v24M28 35h32" stroke="${c}" stroke-width="5" stroke-linecap="round"/></g>`);if(kind==='hand'||kind==='handEye')return wrap(`${kind==='handEye'?'<ellipse cx="52" cy="42" rx="22" ry="11" fill="#dbeafe" stroke="'+a+'" stroke-width="4"/><circle cx="52" cy="42" r="5" fill="'+a+'"/>':''}<path d="M18 28h34M30 17l12 11M30 39l12-11" stroke="${c}" stroke-width="6" stroke-linecap="round" fill="none"/>`);if(kind==='eye'||kind==='eyeLegs')return wrap(`<ellipse cx="44" cy="30" rx="28" ry="15" fill="#dbeafe" stroke="${a}" stroke-width="5"/><circle cx="44" cy="30" r="7" fill="${a}"/>${kind==='eyeLegs'?'<path d="M38 46l-8 10M50 46l8 10" stroke="'+c+'" stroke-width="5" stroke-linecap="round"/>':''}`);if(kind==='heart')return wrap(`<path d="M44 54S18 38 18 23c0-8 6-13 13-13 6 0 10 4 13 9 3-5 7-9 13-9 7 0 13 5 13 13 0 15-26 31-26 31z" fill="#fecdd3" stroke="${r}" stroke-width="5"/>`);if(kind==='door'||kind==='doorMouth'||kind==='doorSun')return wrap(`<path d="M22 56V12h44v44M34 56V22h20v34" stroke="${c}" stroke-width="5" stroke-linecap="round" fill="none"/>${kind==='doorMouth'?'<rect x="36" y="31" width="16" height="12" rx="5" fill="#fee2e2" stroke="'+r+'" stroke-width="4"/>':''}${kind==='doorSun'?'<circle cx="44" cy="37" r="8" fill="#fde68a" stroke="'+o+'" stroke-width="4"/>':''}`);if(kind==='vehicle')return wrap(`<rect x="18" y="25" width="52" height="20" rx="6" fill="#e0f2fe" stroke="${a}" stroke-width="5"/><circle cx="30" cy="49" r="6" fill="${c}"/><circle cx="58" cy="49" r="6" fill="${c}"/>`);if(kind==='wing')return wrap(`<path d="M18 48c18-30 36-38 54-34-8 9-17 18-31 24l18 2c-12 7-24 10-41 8z" fill="#dbeafe" stroke="${a}" stroke-width="5" stroke-linejoin="round"/>`);if(kind==='field'||kind==='fieldPower')return wrap(`<rect x="16" y="14" width="36" height="36" fill="#dcfce7" stroke="${g}" stroke-width="5"/><path d="M34 14v36M16 32h36" stroke="${g}" stroke-width="4"/>${kind==='fieldPower'?'<path d="M62 14c-1 18-6 32-18 42M54 28h20" stroke="'+c+'" stroke-width="5" stroke-linecap="round"/>':''}`);if(kind==='power')return wrap(`<path d="M52 12c-1 20-8 34-24 44M36 27h32" stroke="${c}" stroke-width="6" stroke-linecap="round"/>`);if(kind==='roof'||kind==='roofChild'||kind==='school')return wrap(`<path d="M18 22 44 8l26 14M22 22h44v34H22z" fill="#fef3c7" stroke="${o}" stroke-width="5" stroke-linejoin="round"/>${kind==='roofChild'?'<circle cx="44" cy="33" r="6" fill="#fde68a" stroke="'+o+'" stroke-width="3"/><path d="M44 40v12M34 46h20" stroke="'+c+'" stroke-width="4" stroke-linecap="round"/>':''}${kind==='school'?'<path d="M31 36h26M31 47h26" stroke="'+c+'" stroke-width="4" stroke-linecap="round"/>':''}`);if(kind==='book'||kind==='text')return wrap(`<path d="M20 14h22c7 0 10 4 10 10v30H30c-6 0-10-4-10-10V14zM52 24c0-6 3-10 10-10h6v40H52V24z" fill="#eef2ff" stroke="${a}" stroke-width="5" stroke-linejoin="round"/>${kind==='text'?'<path d="M30 25h12M30 36h12M58 25h6M58 36h6" stroke="'+c+'" stroke-width="3" stroke-linecap="round"/>':''}`);if(kind==='speech')return wrap(`<path d="M20 18h48v28H37L24 56V46h-4V18z" fill="#e0f2fe" stroke="${a}" stroke-width="5" stroke-linejoin="round"/><path d="M31 30h26M31 39h17" stroke="${c}" stroke-width="4" stroke-linecap="round"/>`);if(kind==='money')return wrap(`<circle cx="44" cy="32" r="24" fill="#dcfce7" stroke="${g}" stroke-width="5"/><path d="M44 15v34M34 25c0-7 20-7 20 0 0 8-22 5-22 14 0 7 22 7 24 0" stroke="${g}" stroke-width="5" stroke-linecap="round" fill="none"/>`);if(kind==='bowl')return wrap(`<path d="M20 32h48c-2 15-11 24-24 24S22 47 20 32z" fill="#fee2e2" stroke="${r}" stroke-width="5"/><path d="M28 23c6-8 26-8 32 0" stroke="${o}" stroke-width="5" stroke-linecap="round"/>`);if(kind==='tea')return wrap(`<path d="M44 52V28M30 34c-12-4-12-18 3-20 8 3 10 11 11 20M58 34c12-4 12-18-3-20-8 3-10 11-11 20" fill="#dcfce7" stroke="${g}" stroke-width="5" stroke-linejoin="round"/><path d="M30 54h28" stroke="#8b5a2b" stroke-width="5" stroke-linecap="round"/>`);if(kind==='lightning')return wrap(`<rect x="20" y="14" width="42" height="36" rx="6" fill="#fef3c7" stroke="${o}" stroke-width="5"/><path d="M48 10 32 34h14l-7 20 18-28H43l5-16z" fill="#fde047" stroke="${o}" stroke-width="4" stroke-linejoin="round"/>`);if(kind==='tower')return wrap(`<path d="M28 56V20l16-12 16 12v36M24 56h40M34 30h20M34 42h20" fill="#f3f4f6" stroke="${c}" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>`);if(kind==='rice'||kind==='dots')return wrap(`<path d="M44 12v40M24 32h40M30 18l28 28M58 18 30 46" stroke="${o}" stroke-width="5" stroke-linecap="round"/>`);if(kind==='shirt')return wrap(`<path d="M32 14 18 26l10 10v20h32V36l10-10-14-12-12 8-12-8z" fill="#e0f2fe" stroke="${a}" stroke-width="5" stroke-linejoin="round"/>`);if(kind==='wrap')return wrap(`<path d="M22 18h32c10 0 16 7 14 16-2 11-11 20-30 22H22V18z" fill="#fef3c7" stroke="${o}" stroke-width="5" stroke-linejoin="round"/>`);if(kind==='exit')return wrap(`<path d="M24 52h40M30 44h28M36 36h16M44 12v40" stroke="${c}" stroke-width="6" stroke-linecap="round"/>`);if(kind==='open')return wrap(`<path d="M22 18v38M66 18v38M22 36c13-12 31-12 44 0" stroke="${g}" stroke-width="6" stroke-linecap="round" fill="none"/>`);if(kind==='straight')return wrap(`<path d="M22 16h42M44 16v36M28 52h38" stroke="${c}" stroke-width="6" stroke-linecap="round"/>`);if(kind==='no')return wrap(`<path d="M22 18h44M44 18v36M44 30 26 52M44 30l20 22" stroke="${r}" stroke-width="6" stroke-linecap="round"/>`);if(kind==='sit')return wrap(`<path d="M26 22 18 42M26 22l12 20M62 22l8 20M62 22 50 42M20 50h48" stroke="${c}" stroke-width="5" stroke-linecap="round"/>`);if(kind==='sunrise'||kind==='star')return wrap(`<circle cx="44" cy="22" r="13" fill="#fde68a" stroke="${o}" stroke-width="5"/><path d="M24 50h40M44 36v16" stroke="${c}" stroke-width="5" stroke-linecap="round"/>${kind==='star'?'<path d="M44 7v8M31 13l6 6M57 13l-6 6" stroke="'+o+'" stroke-width="4" stroke-linecap="round"/>':''}`);if(kind==='country')return wrap(`<rect x="16" y="12" width="56" height="40" rx="3" fill="#eef2ff" stroke="${a}" stroke-width="5"/><rect x="34" y="24" width="20" height="16" rx="2" fill="#fff" stroke="${c}" stroke-width="4"/>`);if(kind==='above')return wrap(`<path d="M18 44h52M44 18v26M34 28h20" stroke="${c}" stroke-width="6" stroke-linecap="round"/>`);if(kind==='below')return wrap(`<path d="M18 20h52M44 20v30M34 42h20" stroke="${c}" stroke-width="6" stroke-linecap="round"/>`);if(kind==='center')return wrap(`<rect x="24" y="18" width="40" height="28" fill="#eef2ff" stroke="${a}" stroke-width="5"/><path d="M44 10v44" stroke="${c}" stroke-width="6" stroke-linecap="round"/>`);if(kind==='cross')return wrap(`<path d="M44 10v44M20 32h48" stroke="${c}" stroke-width="7" stroke-linecap="round"/>`);if(kind==='lines1'||kind==='lines2'||kind==='lines3'){const n=+kind.slice(-1);return wrap(Array.from({length:n},(_,i)=>`<path d="M22 ${24+i*12}h44" stroke="${c}" stroke-width="6" stroke-linecap="round"/>`).join(''))}return wrap(text)}
function mnemonicData(ch){return MNEMONICS[ch]||null}
function renderMnemonic(hanzi){const box=document.getElementById('mnemonicWrap');if(!box)return false;const chars=[...new Set([...hanzi].filter(ch=>/\p{Script=Han}/u.test(ch)))].slice(0,4);const tiles=chars.map(ch=>{const m=mnemonicData(ch);if(!m)return '';const [title,kind,note]=m;return `<div class="mnemonic-tile">${mnemonicSvg(kind,ch)}<div class="mnemonic-char">${esc(ch)}</div><div class="mnemonic-title">${esc(title)}</div><div class="mnemonic-note">${esc(note)}</div></div>`}).filter(Boolean);box.innerHTML=tiles.join('');return tiles.length>0}
function switchTab(name){document.querySelectorAll('.section').forEach(s=>s.classList.remove('active'));document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));document.getElementById(name).classList.add('active');document.querySelector(`[data-tab="${name}"]`)?.classList.add('active');if(name==='learn'){renderFlash();if(autoPlay){scheduleAutoPlay();}else if(autoSound){queueSpeak(3000);}}else{clearTimeout(autoPlayTimer);}}
function openVocabFilter(filter){document.getElementById('search').value='';document.getElementById('filter').value=filter;renderList();switchTab('all');}
function updateFilterSelect(){const sel=document.getElementById('filter');if(!sel)return;const learnedN=Object.keys(state.learned).length;const newN=VOCAB.filter(w=>!state.learned[w.id]).length;const todayN=state.today.length;const dueN=VOCAB.filter(isDue).length;const opts=[['all',`Tất cả (${VOCAB.length})`],['new',`Chưa học (${newN})`],['learned',`Đã học (${learnedN})`],['today',`Trong bài hôm nay (${todayN})`],['due',`Đến hạn ôn (${dueN})`]];const cur=sel.value;sel.innerHTML=opts.map(([v,t])=>`<option value="${v}"${v===cur?' selected':''}>${t}</option>`).join('');}
function render(){document.getElementById('stTotal').textContent=VOCAB.length;document.getElementById('stLearned').textContent=Object.keys(state.learned).length;document.getElementById('stDue').textContent=VOCAB.filter(isDue).length;document.getElementById('todayCount').textContent=state.today.length+' từ';updateFilterSelect();renderPlan();renderToday();renderList();renderHistory();renderFlash();}
function rowHtml(id,checkAttr=''){const w=word(id),done=state.learned[id],due=w&&isDue(w),selectable=!!checkAttr;const status=`${done?'<span class="badge done">✓ Đã thuộc</span>':''}${due?'<span class="badge review">↻ Cần ôn</span>':''}${done?`<button class="btn-restudy" data-restudy="${id}" title="Đưa từ này vào bài hôm nay để học lại">↻ Học lại</button>`:''}`;return `<div class="word ${selectable?'selectable':''} ${done?'is-done':''}" data-id="${id}">${selectable?`<input type="checkbox" ${checkAttr}>`:'<div class="word-spacer"></div>'}<div><div class="hz">${w.id}. ${w.hanzi} <span class="py">${w.pinyin}</span></div><div class="mean">${w.pos} • ${w.meaning}</div></div><div class="word-status">${status}</div></div>`}
function syncSelectVisible(){const all=[...document.querySelectorAll('[data-pick]')],sel=document.getElementById('selectVisible');if(!sel)return;const n=all.filter(x=>x.checked).length;sel.checked=all.length>0&&n===all.length;sel.indeterminate=n>0&&n<all.length;const cc=document.getElementById('checkedCount');const cr=document.getElementById('checkedCountRow');if(cc)cc.textContent=n;if(cr)cr.style.display=n>0?'block':'none';}
function bindSelectableRows(root){root.querySelectorAll('.word.selectable').forEach(row=>{const cb=row.querySelector('input[type="checkbox"]');if(!cb)return;cb.onclick=e=>{e.stopPropagation();setTimeout(syncSelectVisible,0)};row.onclick=ev=>{if(ev.target.closest('[data-restudy]'))return;cb.checked=!cb.checked;if(cb.dataset.pick)syncSelectVisible();};});root.querySelectorAll('[data-restudy]').forEach(btn=>{btn.onclick=e=>{e.stopPropagation();restudyWord(+btn.dataset.restudy);};});root.querySelectorAll('.word[data-id]').forEach(row=>{row.addEventListener('click',ev=>{if(ev.target.closest('button')||ev.target.closest('input'))return;const id=+row.dataset.id;if(id)speakWord(word(id));});});}
function selectedPickIds(){return [...document.querySelectorAll('[data-pick]:checked')].map(x=>+x.dataset.pick)}
function requirePicked(ids){if(ids.length)return true;alert('Chọn ít nhất 1 từ trước.');return false}
function planDate(k){const d=new Date(PLAN_START+"T00:00:00");d.setDate(d.getDate()+k);return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;}
function lessonIdsFor(n){return VOCAB.slice(n*LESSON_SIZE,(n+1)*LESSON_SIZE).map(w=>w.id);}
function lessonDone(n){return lessonIdsFor(n).every(id=>state.learned[id]);}
function startPlanLesson(n){state.today=lessonIdsFor(n);idx=0;flipped=false;resetLessonOrder();snapshotToday();save();switchTab('learn');}
function renderPlan(){const top=document.getElementById('planToday'),list=document.getElementById('planList');if(!top||!list)return;const ti=daysBetween(PLAN_START,todayISO());if(ti<0){top.innerHTML=`<p class="small">Lộ trình bắt đầu <b>${PLAN_START}</b> (ngày mai). Mỗi ngày 1 bài • ${LESSON_SIZE} cụm/bài • ${LESSON_COUNT} ngày.</p><button class="primary" data-plan="0">Xem trước Bài 1 →</button>`;}else if(ti>=LESSON_COUNT){top.innerHTML=`<p class="small">🎉 Bạn đã đi hết lộ trình ${LESSON_COUNT} bài. Bấm bài bất kỳ bên dưới để ôn lại.</p>`;}else{top.innerHTML=`<button class="primary" data-plan="${ti}">▶ Học Bài ${ti+1} hôm nay (${LESSON_SIZE} cụm)</button>`;}const _due=dueIds().length;if(_due)top.innerHTML+=`<button class="primary" data-review="1" style="margin-top:8px;background:linear-gradient(180deg,#0ea5e9,#0284c7);box-shadow:0 4px 14px rgba(14,165,233,.32)">🔁 Ôn tập ${_due} thẻ đến hạn</button>`;
list.innerHTML='<div class="plan-grid">'+Array.from({length:LESSON_COUNT},(_,k)=>{const date=planDate(k),done=lessonDone(k),isToday=k===ti,cls=isToday?'plan-row is-today':(k<ti?'plan-row is-past':'plan-row'),badge=done?'<span class="badge done">✓ Xong</span>':(isToday?'<span class="badge review">Hôm nay</span>':(k<ti?'<span class="badge">Đã qua</span>':'<span class="badge">Sắp tới</span>'));return `<div class="${cls}"><div><b>Bài ${k+1}</b><div class="mean">${date} • ${LESSON_SIZE} cụm</div></div><div class="row" style="gap:6px;flex-wrap:nowrap">${badge}<button data-plan="${k}">Học</button></div></div>`;}).join('')+'</div>';[top,list].forEach(r=>r.querySelectorAll('[data-plan]').forEach(b=>b.onclick=()=>startPlanLesson(+b.dataset.plan)));top.querySelectorAll('[data-review]').forEach(b=>b.onclick=()=>{const ids=dueIds();if(ids.length)startLesson(ids);});}
function renderToday(){const box=document.getElementById('todayList');if(!state.today.length){box.innerHTML='<p class="small">Chưa có bài học. Bấm “Auto tạo bài”.</p>';return}box.innerHTML=state.today.map(id=>rowHtml(id,`data-remove="${id}"`)).join('')+'<div style="margin-top:10px"><button id="btnRemoveTick">Bỏ từ đã tick khỏi bài</button></div>';bindSelectableRows(box);document.getElementById('btnRemoveTick')?.addEventListener('click',()=>{const ids=[...document.querySelectorAll('[data-remove]:checked')].map(x=>+x.dataset.remove);state.today=state.today.filter(id=>!ids.includes(id));idx=0;resetLessonOrder();save();})}
function renderList(){updateFilterSelect();const q=document.getElementById('search')?.value?.trim().toLowerCase()||'';const f=document.getElementById('filter')?.value||'all';let arr=VOCAB.filter(w=>{const hay=(w.hanzi+' '+w.pinyin+' '+w.meaning+' '+w.pos).toLowerCase();if(q&&!hay.includes(q))return false;if(f==='new'&&state.learned[w.id])return false;if(f==='learned'&&!state.learned[w.id])return false;if(f==='today'&&!state.today.includes(w.id))return false;if(f==='due'&&!isDue(w))return false;return true;});const box=document.getElementById('wordList');document.getElementById('visibleCount').textContent=arr.length+' từ';box.innerHTML=arr.map(w=>rowHtml(w.id,`data-pick="${w.id}" ${state.today.includes(w.id)?'checked':''}`)).join('')||'<p class="small">Không có kết quả.</p>';bindSelectableRows(box);syncSelectVisible();}
function renderHistory(){const box=document.getElementById('historyList');const dates=Object.keys(state.lessonHistory||{}).sort().reverse();if(!dates.length){box.innerHTML='<p class="small">Chưa có lịch sử. Khi tạo bài hoặc bấm “Đã thuộc”, app sẽ lưu ngày học.</p>';return}box.innerHTML=dates.map(d=>{const ids=state.lessonHistory[d]||[],known=ids.filter(id=>state.learned[id]).length;return `<div class="word history-row ${d===selectedHistoryDate?'active':''}"><div></div><div><b>${d}</b><div class="mean">${ids.length} từ • ${known} đã thuộc</div></div><div class="history-actions"><button data-open-history="${d}">${d===selectedHistoryDate?'Đang mở':'Mở'}</button><button class="primary" data-study-history="${d}">Học lại</button></div></div>`}).join('');document.querySelectorAll('[data-open-history]').forEach(b=>b.onclick=()=>openHistory(b.dataset.openHistory));document.querySelectorAll('[data-study-history]').forEach(b=>b.onclick=()=>startLesson(state.lessonHistory[b.dataset.studyHistory]||[]));}
function openHistory(date){selectedHistoryDate=date;renderHistory();const ids=state.lessonHistory[date]||[];document.getElementById('historyCount').textContent=ids.length+' từ';const hw=document.getElementById('historyWords');hw.innerHTML=ids.length?ids.map(id=>rowHtml(id,'')).join('')+`<div class="row" style="margin-top:10px"><button class="primary" id="btnStudyHistory">Học lại bài ${date}</button><button id="btnUseHistory">Đưa vào bài hôm nay</button></div>`:'<p class="small">Ngày này chưa có từ.</p>';bindSelectableRows(hw);document.getElementById('historyDetailCard')?.scrollIntoView({behavior:'smooth',block:'start'});document.getElementById('btnStudyHistory')?.addEventListener('click',()=>startLesson(ids));document.getElementById('btnUseHistory')?.addEventListener('click',()=>{state.today=[...new Set([...state.today,...ids])];idx=0;flipped=false;resetLessonOrder();snapshotToday();save();switchTab('today');});}
function snapshotToday(){const d=todayISO();state.lessonHistory[d]=[...new Set([...(state.lessonHistory[d]||[]),...state.today])];}
function startLesson(ids){state.today=[...ids];idx=0;flipped=false;resetLessonOrder();save();switchTab('learn');}
function autoLesson(){const n=Math.max(1,+document.getElementById('newCount').value||20);const r=Math.max(0,+document.getElementById('reviewCount').value||5);const due=VOCAB.filter(isDue).sort((a,b)=>state.learned[a.id].localeCompare(state.learned[b.id])).slice(0,r).map(w=>w.id);const fresh=VOCAB.filter(w=>!state.learned[w.id]&&!due.includes(w.id)).slice(0,n).map(w=>w.id);state.today=[...new Set([...due,...fresh])];idx=0;flipped=false;resetLessonOrder();snapshotToday();save();switchTab('learn');}
function renderFlash(){const ids=lessonIds();if(idx>=ids.length)idx=0;if(idx<0)idx=0;const fc=document.getElementById('flashcard');fc.classList.toggle('is-flipped',flipped);const sa=document.getElementById('studyActions');if(sa)sa.classList.toggle('flipped',flipped);const total=lessonOrder.length,pend=lessonOrder.filter(isPending).length,done=total-pend;const title=document.getElementById('lessonTitle'),bar=document.getElementById('bar');const w=currentWord();const memo=document.getElementById('mnemonicWrap');const banner=document.getElementById('fcLearnedBadge');if(!w){if(total>0&&!studyAllMode){title.textContent=`🎉 Xong bài • ${total}/${total}`;bar.style.width='100%';document.getElementById('fcHanzi').textContent='🎉';document.getElementById('fcFrontPeek').textContent='';document.getElementById('fcPinyin').textContent='Hoàn thành!';document.getElementById('fcHanViet').textContent='';document.getElementById('fcMeaning').textContent='Hôm nay không còn thẻ cần ôn trong bài này. Vào tab Trang chủ để ôn thẻ đến hạn hoặc học bài kế tiếp.';document.getElementById('fcPos').textContent='';}else{title.textContent='Chưa có bài học';bar.style.width='0%';document.getElementById('fcHanzi').textContent='—';['fcPinyin','fcHanViet','fcMeaning','fcPos','fcFrontPeek'].forEach(id=>{document.getElementById(id).textContent='';});}memo.innerHTML='';memo.classList.add('hidden');banner.classList.add('hidden');updateAudioBtns();return}title.textContent=studyAllMode?`Tất cả • ${idx+1}/${ids.length}`:`Còn ${pend} thẻ • ${done}/${total} xong`;bar.style.width=total?`${Math.round(done/total*100)}%`:'0%';document.getElementById('fcHanzi').textContent=w.hanzi;document.getElementById('fcFrontPeek').textContent=w.hanzi;document.getElementById('fcPinyin').textContent=w.pinyin;document.getElementById('fcHanViet').textContent=w.hanviet||hanVietText(w.hanzi);document.getElementById('fcMeaning').textContent=w.meaning;document.getElementById('fcPos').innerHTML=w.word?`<span class="word-learn"><span class="wl-r1">Từ cần học: <b>${esc(w.word)}</b> · ${esc(w.wpy)}</span><span class="wl-r2">${esc(w.whv)} — ${esc(w.wmean)}</span></span>`:esc(w.pos||'');const hasMnemonic=renderMnemonic(w.hanzi);memo.classList.toggle('hidden',!hasMnemonic);banner.classList.toggle('hidden',!state.learned[w.id]);const s=state.srs[w.id];const setiv=(eid,q)=>{const el=document.getElementById(eid);if(el)el.textContent=fmtIvl(srsPredict(s,q).ivl);};setiv('ivAgain','again');setiv('ivHard','hard');setiv('ivGood','good');setiv('ivEasy','easy');updateAudioBtns();}
function snapFlipReset(){const fc=document.getElementById('flashcard');if(!fc.classList.contains('is-flipped'))return;fc.classList.add('no-flip-anim');setTimeout(()=>fc.classList.remove('no-flip-anim'),120);}
function flipCard(){flipped=!flipped;renderFlash();if(autoPlay){scheduleAutoPlay();}else if(flipped&&autoSound){queueSpeak(3000);}}
function animateCard(dir){const card=document.getElementById('flashcard');if(!card)return;card.classList.remove('page-next','page-prev');void card.offsetWidth;card.classList.add(dir==='prev'?'page-prev':'page-next');setTimeout(()=>card.classList.remove('page-next','page-prev'),1000)}
function queueSpeak(delay=1000){if(!autoSound||autoPlay)return;const ss=window.speechSynthesis;ss?.resume?.();clearTimeout(speakTimer);speakTimer=setTimeout(speak,delay)}
function prevCard(){const ids=lessonIds();if(!ids.length)return;idx=(idx-1+ids.length)%ids.length;flipped=false;snapFlipReset();renderFlash();animateCard('prev');queueSpeak(3000);scheduleAutoPlay();persist();}
function nextCard(){const ids=lessonIds();if(!ids.length)return;idx=(idx+1)%ids.length;flipped=false;snapFlipReset();renderFlash();animateCard('next');queueSpeak(3000);scheduleAutoPlay();persist();}
function markKnown(){const ids=lessonIds();if(!ids.length)return;const id=ids[idx];if(state.learned[id]){nextCard();}else{state.learned[id]=todayISO();state.reviewLog[id]=[...(state.reviewLog[id]||[]),todayISO()];snapshotToday();nextCard();save();}}
function voiceScore(v){const n=(v.name||'').toLowerCase(),l=(v.lang||'').toLowerCase(),k=n+' '+l;let s=0;if(/cn|china|mandarin|putonghua|普通话|大陆|hans/.test(k))s+=5;if(/natural|neural|online|premium|enhanced/.test(n))s+=6;if(/google/.test(n))s+=4;if(/microsoft/.test(n))s+=3;if(/tingting|婷婷|meijia|美佳|xiaoxiao|晓晓|yunxi|云希|yunyang|云扬|xiaoyi|晓伊|sinji/.test(n))s+=3;if(v.localService===false)s+=2;if(/taiwan|cantonese|粤|香港|台|\btw\b|\bhk\b/.test(k))s-=4;return s;}
function loadVoice(){const ss=window.speechSynthesis;if(!ss||!ss.getVoices)return null;const zh=ss.getVoices().filter(v=>/^zh/i.test(v.lang));if(!zh.length)return null;return zh.map(v=>[voiceScore(v),v]).sort((a,b)=>b[0]-a[0])[0][1];}
function initSpeech(){const ss=window.speechSynthesis;if(!ss)return;preferredVoice=loadVoice();ss.onvoiceschanged=()=>{preferredVoice=loadVoice();};}
function ttsText(w){const hz=w.hanzi||'';return /[，,。、！？]/.test(hz)?hz:hz+'。';}
function speakWord(w){if(!w)return;const ss=window.speechSynthesis,Utter=window.SpeechSynthesisUtterance||window.webkitSpeechSynthesisUtterance;if(!ss||!Utter)return;const u=new Utter(ttsText(w));u.lang='zh-CN';u.rate=.8;u.pitch=1;u.volume=1;preferredVoice=preferredVoice||loadVoice();if(preferredVoice)u.voice=preferredVoice;ss.cancel();ss.resume?.();ss.speak(u);setTimeout(()=>ss.resume?.(),50);}
function speak(onEnd){clearTimeout(speakTimer);const w=currentWord(),ss=window.speechSynthesis,Utter=window.SpeechSynthesisUtterance||window.webkitSpeechSynthesisUtterance;if(!w||!ss||!Utter){if(typeof onEnd==='function')setTimeout(onEnd,50);return;}const u=new Utter(ttsText(w));u.lang='zh-CN';u.rate=.8;u.pitch=1;u.volume=1;preferredVoice=preferredVoice||loadVoice();if(preferredVoice)u.voice=preferredVoice;if(typeof onEnd==='function'){let done=false;const fire=()=>{if(done)return;done=true;onEnd();};u.onend=fire;u.onerror=fire;setTimeout(fire,8000);}ss.cancel();ss.resume?.();ss.speak(u);setTimeout(()=>ss.resume?.(),50);}
initSpeech();document.querySelectorAll('.tab').forEach(b=>b.addEventListener('click',()=>switchTab(b.dataset.tab)));document.querySelectorAll('[data-open-filter]').forEach(el=>{el.onclick=()=>openVocabFilter(el.dataset.openFilter);el.onkeydown=e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();openVocabFilter(el.dataset.openFilter);}}});document.getElementById('btnAuto').onclick=autoLesson;document.getElementById('btnContinue').onclick=()=>switchTab('learn');document.getElementById('btnClearToday').onclick=()=>{state.today=[];idx=0;resetLessonOrder();save();};document.getElementById('flashcard').onclick=flipCard;document.getElementById('btnNext').onclick=nextCard;document.getElementById('btnPrev').onclick=prevCard;document.getElementById('btnReveal').onclick=()=>{if(!flipped)flipCard();};document.getElementById('btnShuffle').onclick=shuffleCards;document.querySelectorAll('.grade').forEach(b=>b.onclick=()=>gradeCard(b.dataset.grade));document.addEventListener('keydown',e=>{if(!document.getElementById('learn').classList.contains('active'))return;const tag=(e.target.tagName||'').toLowerCase();if(tag==='input'||tag==='textarea'||tag==='select')return;if(e.code==='Space'||e.key==='Enter'){e.preventDefault();if(!flipped)flipCard();else if(lessonIds().length)gradeCard('good');return;}if(e.key==='ArrowRight'){e.preventDefault();nextCard();return;}if(e.key==='ArrowLeft'){e.preventDefault();prevCard();return;}if(flipped&&lessonIds().length){const m={'1':'again','2':'hard','3':'good','4':'easy'};if(m[e.key]){e.preventDefault();gradeCard(m[e.key]);}}});document.getElementById('btnSpeak').onclick=speak;document.getElementById('btnAutoSound').onclick=()=>{autoSound=!autoSound;updateAudioBtns();if(autoSound)speak();};document.getElementById('btnAutoPlay').onclick=toggleAutoPlay;document.getElementById('btnFilterUnknown').onclick=toggleFilterUnknown;document.getElementById('search').oninput=renderList;document.getElementById('filter').onchange=renderList;document.getElementById('selectVisible').onchange=e=>{document.querySelectorAll('[data-pick]').forEach(cb=>cb.checked=e.target.checked);syncSelectVisible();};document.getElementById('btnAddSelected').onclick=()=>{const ids=selectedPickIds();if(!requirePicked(ids))return;state.today=[...new Set([...state.today,...ids])];resetLessonOrder();snapshotToday();save();switchTab('today');};document.getElementById('btnStudySelected').onclick=()=>{const ids=selectedPickIds();if(requirePicked(ids))startLesson(ids);};document.getElementById('btnForgetSelected').onclick=()=>{const ids=selectedPickIds();if(!requirePicked(ids))return;if(confirm(`Chuyển ${ids.length} từ về chưa học?`)){ids.forEach(id=>{delete state.learned[id];delete state.reviewLog[id];delete state.srs[id];});save();}};
let sx=0,sy=0;const fc=document.getElementById('flashcard');fc.addEventListener('touchstart',e=>{sx=e.changedTouches[0].screenX;sy=e.changedTouches[0].screenY;},{passive:true});fc.addEventListener('touchend',e=>{const dx=e.changedTouches[0].screenX-sx,dy=e.changedTouches[0].screenY-sy;if(Math.abs(dx)>55&&Math.abs(dx)>Math.abs(dy)*1.4){dx<0?nextCard():prevCard();}},{passive:true});
document.getElementById('btnClearData').onclick=()=>{if(confirm('Xoá toàn bộ dữ liệu học đã lưu (tiến độ, từ đã thuộc, lịch sử, lộ trình)?\n\nKhông thể hoàn tác.')){localStorage.removeItem(KEY);location.reload();}};
window.addEventListener('beforeunload',persist);window.addEventListener('pagehide',persist);
render();
</script></body></html>
