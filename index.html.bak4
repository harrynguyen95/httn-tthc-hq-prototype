<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
<title>HSK1 Flashcard</title>
<style>
:root{
  /* Surfaces */
  --bg:#f1f5f9;
  --card:#ffffff;
  --card-2:#f8fafc;
  --text:#0f172a;
  --muted:#64748b;
  --line:#e2e8f0;
  --line-strong:#cbd5e1;
  /* Brand */
  --primary:#4f46e5;
  --primary-dark:#4338ca;
  --primary-soft:#eef2ff;
  --accent:#7c3aed;
  --accent-soft:#f5f3ff;
  /* Semantic */
  --green:#10b981;
  --green-dark:#059669;
  --green-soft:#d1fae5;
  --orange:#f59e0b;
  --orange-dark:#d97706;
  --orange-soft:#fef3c7;
  --red:#ef4444;
  --red-dark:#dc2626;
  --red-soft:#fee2e2;
  /* Effects */
  --radius:16px;
  --radius-sm:12px;
  --radius-lg:22px;
  --shadow-sm:0 1px 2px rgba(15,23,42,.06);
  --shadow:0 4px 16px rgba(15,23,42,.06),0 1px 3px rgba(15,23,42,.04);
  --shadow-lg:0 12px 32px rgba(15,23,42,.10),0 4px 8px rgba(15,23,42,.06);
  --ring:0 0 0 3px rgba(79,70,229,.18);
}
*{box-sizing:border-box}
body{
  margin:0;
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue","Noto Sans SC",Arial,sans-serif;
  background:var(--bg);
  background-image:radial-gradient(1200px 600px at 0% 0%,#eef2ff 0%,transparent 50%),radial-gradient(900px 500px at 100% 100%,#fef3c7 0%,transparent 55%);
  background-attachment:fixed;
  color:var(--text);
  -webkit-font-smoothing:antialiased;
  text-rendering:optimizeLegibility;
}
header{
  position:sticky;top:0;z-index:50;
  background:rgba(241,245,249,.78);
  -webkit-backdrop-filter:saturate(180%) blur(14px);
  backdrop-filter:saturate(180%) blur(14px);
  border-bottom:1px solid var(--line);
  padding:14px 16px;
}
h1{
  max-width:900px;margin:0 auto;
  font-size:20px;font-weight:800;letter-spacing:-.01em;
  display:flex;align-items:center;gap:10px;
}
h1::before{
  content:"汉";
  display:inline-flex;align-items:center;justify-content:center;
  width:32px;height:32px;border-radius:10px;
  background:linear-gradient(135deg,var(--primary),var(--accent));
  color:#fff;font-size:18px;font-weight:900;
  box-shadow:0 4px 10px rgba(79,70,229,.35);
}
main{max-width:900px;margin:0 auto;padding:12px 14px 32px}
.card{
  background:var(--card);
  border:1px solid var(--line);
  border-radius:var(--radius-lg);
  padding:16px;margin:12px 0;
  box-shadow:var(--shadow);
}
.card h3{margin:0 0 10px 0;font-size:15px;font-weight:750;letter-spacing:-.01em;color:#1f2937}
.row{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.stat{
  background:linear-gradient(180deg,#fff,#f8fafc);
  border:1px solid var(--line);
  border-radius:var(--radius);
  padding:14px 10px;text-align:center;
  transition:transform .18s ease,box-shadow .18s ease,border-color .18s ease;
  position:relative;overflow:hidden;
}
.stat-action{cursor:pointer}
.stat-action:hover{transform:translateY(-2px);box-shadow:var(--shadow);border-color:#c7d2fe}
.stat-action:active{transform:translateY(0)}
.stat b{display:block;font-size:24px;font-weight:850;letter-spacing:-.02em;color:var(--text)}
.stat:nth-child(1) b{color:var(--primary)}
.stat:nth-child(2) b{color:var(--green)}
.stat:nth-child(3) b{color:var(--orange)}
.stat span,.small{color:var(--muted);font-size:12px;font-weight:550}
button,input,select,textarea{font:inherit}
button{
  border:0;border-radius:var(--radius);
  padding:10px 14px;
  background:#e5e7eb;color:#1f2937;
  font-weight:650;font-size:14px;cursor:pointer;
  transition:transform .12s ease,box-shadow .15s ease,filter .15s ease;
  letter-spacing:-.01em;
}
button:hover{filter:brightness(1.04)}
button:active{transform:scale(.97)}
button.primary{background:linear-gradient(180deg,var(--primary),var(--primary-dark));color:#fff;box-shadow:0 4px 12px rgba(79,70,229,.28)}
button.primary:hover{box-shadow:0 6px 18px rgba(79,70,229,.38)}
button.green{background:linear-gradient(180deg,var(--green),var(--green-dark));color:#fff;box-shadow:0 4px 12px rgba(16,185,129,.28)}
button.orange{background:linear-gradient(180deg,var(--orange),var(--orange-dark));color:#fff;box-shadow:0 4px 12px rgba(245,158,11,.28)}
button.red{background:linear-gradient(180deg,var(--red),var(--red-dark));color:#fff;box-shadow:0 4px 12px rgba(239,68,68,.28)}
button.ghost{background:#f3f4f6;color:#374151;border:1px solid var(--line)}
button.ghost:hover{background:#fff;border-color:var(--line-strong)}
input,select,textarea{
  width:100%;border:1px solid var(--line);
  border-radius:var(--radius);
  padding:11px 13px;background:#fff;
  transition:border-color .15s,box-shadow .15s;
}
input:focus,select:focus,textarea:focus{
  outline:none;border-color:var(--primary);box-shadow:var(--ring);
}
label{font-size:13px;color:var(--muted);font-weight:600;display:block;margin-bottom:5px}
.today-actions{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-top:12px}
.today-actions button{width:100%;white-space:nowrap;font-size:13px;padding:11px 8px}
.learn-head{padding:14px 16px;margin-bottom:6px}
.learn-head .progressbar{margin-top:10px!important}
.action-card{margin-top:6px;padding:12px 14px}
.study-actions{display:flex;flex-direction:column;gap:8px}
.nav-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.minor-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
.study-actions .nav{
  background:linear-gradient(180deg,#1e293b,#0f172a);
  color:#fff;font-size:15px;padding:12px 12px;font-weight:800;
  box-shadow:0 4px 12px rgba(15,23,42,.22);
  display:inline-flex;align-items:center;justify-content:center;
  min-height:50px;box-sizing:border-box;
}
.study-actions .nav:hover{box-shadow:0 6px 18px rgba(15,23,42,.30)}
.study-actions .minor{
  background:#f8fafc;color:#475569;border:1px solid var(--line);
  font-size:12.5px;padding:8px 8px;font-weight:650;
}
.study-actions .minor:hover{background:#fff;border-color:var(--line-strong)}
#btnKnown,#btnShuffle{
  display:inline-flex;align-items:center;justify-content:center;gap:6px;
  font-size:12.5px;font-weight:650;padding:8px 8px;
  border-radius:12px;box-shadow:none;
  min-height:38px;box-sizing:border-box;
}
#btnKnown.known-active{background:var(--primary-soft);color:var(--primary);border:1px solid #c7d2fe}
#btnKnown.known-active:hover{background:var(--primary);color:#fff}
#btnShuffle.restudy-mode{background:var(--orange-soft);color:var(--orange-dark);border:1px solid var(--orange)}
#btnShuffle.restudy-mode:hover{background:var(--orange);color:#fff}
#btnShuffle{background:#fff;color:#475569;border:1px solid var(--line)}
#btnShuffle:hover{background:#f8fafc;border-color:var(--line-strong);color:var(--text)}
#btnKnown svg,#btnShuffle svg{flex-shrink:0}
.tabs{
  display:grid;grid-template-columns:repeat(4,1fr);gap:6px;
  position:sticky;top:60px;z-index:9;
  background:rgba(241,245,249,.78);
  -webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);
  padding:8px 0 10px;
}
.tab{
  border-radius:14px;background:#fff;color:#475569;
  padding:10px 6px;font-size:12.5px;font-weight:700;
  border:1px solid var(--line);
  transition:all .18s ease;
}
.tab:hover{background:#f8fafc;color:#1f2937}
.tab.active{
  background:linear-gradient(180deg,#1e293b,#0f172a);
  color:#fff;border-color:transparent;
  box-shadow:0 4px 12px rgba(15,23,42,.22);
}
.section{display:none}
.section.active{display:block;animation:fadeIn .25s ease}
@keyframes fadeIn{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}
.word{
  display:grid;grid-template-columns:30px 1fr auto;gap:10px;
  align-items:center;padding:12px 0;border-bottom:1px solid var(--line);
}
.word:last-child{border-bottom:0}
.word.selectable{cursor:pointer;margin:0 -10px;padding:12px 10px;border-radius:var(--radius);transition:background .15s}
.word.selectable:hover{background:#f8fafc}
.word.selectable:has(input:checked){background:var(--primary-soft)}
.word-spacer{width:24px}
.word input[type=checkbox],.checkline input[type=checkbox]{
  appearance:none;-webkit-appearance:none;
  width:22px;height:22px;margin:0;
  border:2px solid var(--line-strong);border-radius:7px;
  background:#fff;display:grid;place-content:center;
  cursor:pointer;transition:.15s;
}
.word input[type=checkbox]::after,.checkline input[type=checkbox]::after{
  content:"";width:6px;height:11px;
  border:solid #fff;border-width:0 2px 2px 0;
  transform:rotate(45deg) scale(0);transition:.15s;
}
.word input[type=checkbox]:checked,.checkline input[type=checkbox]:checked{
  background:var(--primary);border-color:var(--primary);
  box-shadow:0 0 0 3px var(--primary-soft);
}
.word input[type=checkbox]:checked::after,.checkline input[type=checkbox]:checked::after{
  transform:rotate(45deg) scale(1);
}
.checkline{display:flex;align-items:center;gap:10px;margin:12px 0;color:#374151;font-size:13px;font-weight:650}
.list-actions{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px;margin-top:12px}
.list-actions button{font-size:13px;padding:10px 7px}
.history-row.active{background:var(--primary-soft);border-radius:var(--radius);margin:0 -10px;padding:12px 10px}
.history-actions{display:flex;gap:6px;justify-content:flex-end;flex-wrap:wrap}
.history-actions button{white-space:nowrap;font-size:12px;padding:8px 10px}
.hz{font-size:19px;font-weight:850;letter-spacing:-.01em}
.py{color:var(--primary);font-size:14px;font-weight:700;margin-left:4px}
.mean{color:#475569;font-size:13px;margin-top:2px}
.badge{
  display:inline-flex;align-items:center;gap:3px;
  border-radius:999px;padding:3px 9px;font-size:11px;font-weight:650;
  background:#e5e7eb;color:#475569;margin-left:4px;
}
.badge.done{background:var(--green-soft);color:#065f46}
.badge.review{background:var(--orange-soft);color:#92400e}
.flash{
  height:480px;
  display:flex;flex-direction:column;
  justify-content:center;align-items:center;
  text-align:center;gap:14px;
  touch-action:pan-y;user-select:none;
  position:relative;overflow-x:hidden;overflow-y:auto;
  transform-style:preserve-3d;will-change:transform,opacity;
  background:radial-gradient(800px 320px at 50% 0%,#eef2ff 0%,transparent 70%),#fff;
  cursor:pointer;
}
.flash.page-next,.flash.page-prev{overflow:hidden}
.flash.is-flipped::before{display:none}
/* 3D flip: front/back faces */
.flash{perspective:1400px}
.flash-inner{
  position:absolute;inset:0;
  transform-style:preserve-3d;
  transition:transform .85s cubic-bezier(.55,.05,.35,1);
  z-index:1;
}
.flash.is-flipped .flash-inner{transform:rotateY(180deg)}
.flash.no-flip-anim .flash-inner{transition:none}
.flash-face{
  position:absolute;inset:0;
  display:flex;flex-direction:column;
  justify-content:center;align-items:center;
  text-align:center;gap:14px;
  padding:18px;
  -webkit-backface-visibility:hidden;backface-visibility:hidden;
  border-radius:inherit;
  overflow-y:auto;
  background:inherit;
}
.flash-back{transform:rotateY(180deg)}
.front-peek{
  position:static;
  text-align:center;
  font-size:24px;font-weight:900;
  color:#334155;
  letter-spacing:-.01em;
  pointer-events:none;
  line-height:1;
  margin-bottom:-4px;
}
/* Learned banner trong card */
.learned-banner{
  position:absolute;top:10px;right:12px;
  z-index:5;
  display:inline-flex;align-items:center;gap:4px;
  padding:3px 8px 3px 6px;
  background:rgba(240,253,244,.95);
  border:1px solid #a7f3d0;
  border-radius:999px;
  font-size:11px;font-weight:700;color:#065f46;
  box-shadow:0 2px 6px rgba(16,185,129,.15);
  pointer-events:none;
}
.flash::before{display:none}
.flash::after{
  content:"";position:absolute;inset:-10%;pointer-events:none;opacity:0;
  background:linear-gradient(105deg,transparent 0 36%,rgba(255,255,255,.92) 45%,rgba(148,163,184,.28) 50%,rgba(17,24,39,.1) 55%,transparent 66%);
  filter:blur(.2px);
}
.flash.page-next{transform-origin:center right;animation:paperNext 1s cubic-bezier(.22,.8,.22,1) both}
.flash.page-prev{transform-origin:center left;animation:paperPrev 1s cubic-bezier(.22,.8,.22,1) both}
.flash.page-next::after{animation:curlNext 1s cubic-bezier(.22,.8,.22,1) both}
.flash.page-prev::after{animation:curlPrev 1s cubic-bezier(.22,.8,.22,1) both}
@keyframes paperNext{
  0%{transform:perspective(900px) translateX(0) rotateY(0);opacity:1}
  50%{transform:perspective(900px) translateX(-32px) rotateY(-15deg);opacity:.72;box-shadow:18px 12px 26px rgba(15,23,42,.14)}
  100%{transform:perspective(900px) translateX(0) rotateY(0);opacity:1}
}
@keyframes paperPrev{
  0%{transform:perspective(900px) translateX(0) rotateY(0);opacity:1}
  50%{transform:perspective(900px) translateX(32px) rotateY(15deg);opacity:.72;box-shadow:-18px 12px 26px rgba(15,23,42,.14)}
  100%{transform:perspective(900px) translateX(0) rotateY(0);opacity:1}
}
@keyframes curlNext{
  0%{opacity:0;transform:translateX(120%) skewX(-18deg)}
  40%{opacity:.95}
  100%{opacity:0;transform:translateX(-130%) skewX(-18deg)}
}
@keyframes curlPrev{
  0%{opacity:0;transform:translateX(-120%) skewX(18deg)}
  40%{opacity:.95}
  100%{opacity:0;transform:translateX(130%) skewX(18deg)}
}
.flash .big{
  font-size:80px;line-height:1;font-weight:900;
  background:linear-gradient(180deg,#0f172a 0%,#334155 100%);
  -webkit-background-clip:text;background-clip:text;color:transparent;
  letter-spacing:-.02em;
}
.flash .pinyin{font-size:26px;color:var(--primary);font-weight:750;letter-spacing:-.01em}
.flash .hanviet{font-size:20px;color:var(--accent);font-weight:700}
.flash .meaning{font-size:22px;font-weight:600;color:#1f2937;padding:0 12px}
.flash .small{font-size:12px;color:var(--muted);background:#f8fafc;padding:4px 12px;border-radius:999px;border:1px solid var(--line);font-weight:600}
.mnemonic-wrap{
  display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));
  gap:10px;width:100%;max-width:580px;
}
.mnemonic-tile{
  border:1px solid var(--line);border-radius:var(--radius);
  background:linear-gradient(180deg,#fff,#f8fafc);
  padding:10px;min-height:160px;
  display:flex;flex-direction:column;align-items:center;gap:6px;
  transition:transform .15s,box-shadow .15s;
}
.mnemonic-tile:hover{transform:translateY(-2px);box-shadow:var(--shadow-sm)}
.mnemonic-visual{width:88px;height:64px}
.mnemonic-char{font-size:34px;font-weight:900;line-height:1;color:#1f2937}
.mnemonic-title{font-size:13px;font-weight:750;color:var(--primary)}
.mnemonic-note{font-size:12px;line-height:1.35;color:var(--muted)}
.progressbar{
  height:8px;background:#e5e7eb;border-radius:999px;overflow:hidden;
}
.progressbar>div{
  height:100%;
  background:linear-gradient(90deg,var(--primary),var(--accent));
  width:0%;transition:width .35s ease;
  box-shadow:0 0 12px rgba(79,70,229,.40);
}
.hidden{display:none!important}
/* Floating "Nghe" button — bám sát viền phải màn hình */
.fab-speak{
  position:fixed;right:0;top:50%;transform:translateY(-50%);
  width:54px;height:64px;
  border-radius:20px 0 0 20px;
  background:linear-gradient(135deg,var(--primary),var(--accent));
  color:#fff;font-size:26px;border:0;padding:0;
  box-shadow:-4px 6px 18px rgba(79,70,229,.40);
  z-index:100;cursor:pointer;
  display:flex;align-items:center;justify-content:center;
  transition:transform .18s cubic-bezier(.22,.8,.22,1),box-shadow .18s ease;
}
.fab-speak:hover{transform:translateY(-50%) translateX(-3px);box-shadow:-6px 10px 24px rgba(79,70,229,.55)}
.fab-speak:active{transform:translateY(-50%) scale(.94)}
/* Status & restudy button trên thẻ */
.word-status{display:flex;align-items:center;flex-wrap:wrap;gap:6px;justify-content:flex-end}
.btn-restudy{
  background:var(--orange-soft);color:var(--orange-dark);
  font-size:11px;font-weight:700;padding:5px 10px;
  border-radius:999px;border:1px solid transparent;
  cursor:pointer;white-space:nowrap;
  display:inline-flex;align-items:center;gap:3px;
  transition:all .15s ease;
}
.btn-restudy:hover{background:var(--orange);color:#fff;border-color:var(--orange)}
.btn-restudy:active{transform:scale(.96)}
.word.is-done .hz{color:#0f766e}
.word.is-done{background:linear-gradient(90deg,rgba(16,185,129,.04),transparent)}
.word.selectable.is-done:hover{background:linear-gradient(90deg,rgba(16,185,129,.08),#f8fafc)}
/* Small icon-only buttons in learn-head (auto sound + auto play) */
.icon-btn{
  width:40px;height:40px;padding:0;
  display:inline-flex;align-items:center;justify-content:center;
  font-size:16px;line-height:1;
  border-radius:12px;
  background:#f8fafc;color:#475569;
  border:1px solid var(--line);
  cursor:pointer;transition:all .15s ease;
}
.icon-btn:hover{background:#fff;border-color:var(--line-strong);color:var(--text)}
.icon-btn:active{transform:scale(.94)}
.icon-btn.is-active{
  background:var(--primary-soft);
  border-color:var(--primary);
  color:var(--primary);
  box-shadow:0 0 0 3px rgba(79,70,229,.10);
}
.icon-btn.is-active.play{background:#fef3c7;border-color:var(--orange);color:var(--orange-dark);box-shadow:0 0 0 3px rgba(245,158,11,.14)}
@media(max-width:520px){
  main{padding:8px 12px 12px}
  header{padding:10px 12px}
  h1{font-size:18px}
  h1::before{width:28px;height:28px;font-size:15px}
  .tabs{gap:4px;top:54px;padding:6px 0 8px}
  .tab{font-size:11px;padding:9px 3px}
  button{padding:10px 8px}
  /* Learn screen: fit mobile viewport, no page scroll */
  #learn.section.active{
    display:flex;flex-direction:column;
    min-height:calc(100vh - 140px);
    min-height:calc(100dvh - 140px);
    gap:6px;
  }
  #learn .card{margin:0}
  #learn .learn-head{flex-shrink:0;padding:10px 12px}
  #learn .learn-head .progressbar{margin-top:8px!important;height:6px}
  #learn .flash{
    flex:1 1 0;min-height:230px;margin:0;padding:12px;gap:8px;
    overflow-x:hidden;overflow-y:auto;
  }
  #learn .flash.page-next,#learn .flash.page-prev{overflow:hidden}
  #learn .action-card{flex-shrink:0;padding:10px;margin:0}
  .flash .big{font-size:58px}
  .flash .pinyin{font-size:22px}
  .flash .hanviet{font-size:17px}
  .flash .meaning{font-size:18px;padding:0 8px}
  .today-actions{gap:6px}
  .today-actions button,.list-actions button{font-size:12px;padding:10px 4px}
  .nav-actions{grid-template-columns:1fr 1fr;gap:6px}
  .study-actions{gap:6px}
  .study-actions .nav{font-size:14px;padding:11px 6px;min-height:46px}
  .study-actions .minor,#btnKnown,#btnShuffle{font-size:11.5px;padding:7px 4px;min-height:36px;white-space:nowrap}
  .minor-actions{gap:6px}
  .stat b{font-size:21px}
  .mnemonic-wrap{grid-template-columns:repeat(2,1fr);gap:6px;max-width:100%}
  .mnemonic-tile{min-height:120px;padding:6px;gap:3px}
  .mnemonic-visual{width:64px;height:46px}
  .mnemonic-char{font-size:26px}
  .mnemonic-title{font-size:11px}
  .mnemonic-note{font-size:10.5px;line-height:1.3}
  .icon-btn{width:36px;height:36px;border-radius:10px}
  .plan-row{flex-wrap:wrap}
  .fab-speak{width:48px;height:58px;font-size:22px}
  .fab-speak svg{width:22px;height:22px}
}
.plan-grid{display:grid;gap:8px}
.plan-row{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:10px 12px;border:1px solid #e5e7eb;border-radius:12px;background:#fff}
.plan-row.is-today{border-color:var(--primary);box-shadow:0 0 0 2px rgba(79,70,229,.12)}
.plan-row.is-past{opacity:.6}
.plan-row .mean{font-size:12px;color:var(--muted)}
.word-learn{display:block;margin-top:0;font-size:13px;color:var(--muted);line-height:1.5}
.word-learn .wl-r1,.word-learn .wl-r2{display:block}
.word-learn b{color:var(--accent);font-size:15px}
#btnClearData{position:fixed;right:8px;bottom:8px;width:26px;height:26px;border-radius:50%;border:none;background:transparent;color:#94a3b8;opacity:.16;cursor:pointer;z-index:60;display:flex;align-items:center;justify-content:center;transition:opacity .2s,background .2s}
#btnClearData:hover{opacity:.9;background:rgba(239,68,68,.12);color:var(--red)}
.study-actions .reveal-btn{background:linear-gradient(180deg,#4f46e5,#4338ca);color:#fff;width:100%;font-size:16px;font-weight:800;padding:14px;border-radius:14px;display:flex;align-items:center;justify-content:center;gap:8px;min-height:52px;box-sizing:border-box;box-shadow:0 4px 14px rgba(79,70,229,.35)}
.study-actions .reveal-btn:hover{filter:brightness(1.06)}
.study-actions .reveal-btn kbd{font-size:11px;font-weight:600;background:rgba(255,255,255,.22);padding:2px 6px;border-radius:6px}
.grade-actions{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.grade-actions .grade{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;padding:9px 4px;border-radius:12px;font-weight:750;font-size:14px;border:none;min-height:52px;box-sizing:border-box;color:#fff;box-shadow:0 3px 10px rgba(15,23,42,.16)}
.grade-actions .grade small{font-size:10px;font-weight:600;opacity:.95}
.grade-actions .g-again{background:#ef4444}.grade-actions .g-again:hover{background:#dc2626}
.grade-actions .g-hard{background:#f59e0b}.grade-actions .g-hard:hover{background:#d97706}
.grade-actions .g-good{background:#10b981}.grade-actions .g-good:hover{background:#059669}
.grade-actions .g-easy{background:#3b82f6}.grade-actions .g-easy:hover{background:#2563eb}
#studyActions .grade-actions{display:none}
#studyActions.flipped .grade-actions{display:grid}
#studyActions.flipped .reveal-btn{display:none}
.study-actions .minor-actions{grid-template-columns:repeat(3,minmax(0,1fr))}
</style>
</head><body>
<header><h1>HSK1 Flashcard</h1></header>
<main>
<div class="tabs"><button class="tab active" data-tab="today">Trang chủ</button><button class="tab" data-tab="learn">Học</button><button class="tab" data-tab="history">Lịch sử</button><button class="tab" data-tab="all">Từ vựng</button></div>
<section id="today" class="section active"><div class="card"><div class="grid"><div class="stat stat-action" data-open-filter="all" role="button" tabindex="0"><b id="stTotal">300</b><span>Tổng từ</span></div><div class="stat stat-action" data-open-filter="learned" role="button" tabindex="0"><b id="stLearned">0</b><span>Đã học</span></div><div class="stat stat-action" data-open-filter="due" role="button" tabindex="0"><b id="stDue">0</b><span>Cần ôn</span></div></div></div><div class="card"><h3 style="margin-top:0">Lộ trình HSK1 <span class="badge">10 bài</span></h3><div id="planToday"></div><div id="planList" style="margin-top:12px"></div></div><div class="card"><h3 style="margin-top:0">Tạo bài học hôm nay</h3><div class="row"><div style="flex:1;min-width:120px"><label>Từ mới</label><input id="newCount" type="number" min="1" max="50" value="20"/></div><div style="flex:1;min-width:120px"><label>Ôn thẻ đến hạn</label><input id="reviewCount" type="number" min="0" max="30" value="5"/></div></div><div class="today-actions"><button class="primary" id="btnAuto">Auto tạo bài</button><button class="ghost" id="btnContinue">Học hiện tại</button><button class="red" id="btnClearToday">Xoá bài hôm nay</button></div><p class="small">Tự trộn 1 bài gồm thẻ đến hạn ôn (theo lịch SM-2) và thẻ mới chưa học. Thường ngày chỉ cần dùng “Lộ trình” và “Ôn tập đến hạn” ở trên.</p></div><div class="card"><h3 style="margin-top:0">Bài hôm nay <span id="todayCount" class="badge">0 từ</span></h3><div id="todayList"></div></div></section>
<section id="learn" class="section"><div class="card learn-head"><div class="row" style="justify-content:space-between"><div><b id="lessonTitle">Chưa có bài học</b></div><div class="row" style="gap:6px"><button id="btnFilterUnknown" class="icon-btn" title="Chỉ xem thẻ chưa thuộc" aria-label="Chưa thuộc"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 3H2l8 9.46V19l4 2V12.46L22 3z"/></svg></button><button id="btnAutoPlay" class="icon-btn" title="Tự chạy thẻ" aria-label="Tự chạy"></button><button id="btnAutoSound" class="icon-btn" title="Tự đọc khi sang thẻ" aria-label="Tự đọc"></button><button id="btnSpeak" class="icon-btn" style="margin-left:10px" title="Nghe thẻ này" aria-label="Nghe"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/></svg></button></div></div><div class="progressbar" style="margin-top:12px"><div id="bar"></div></div></div><div class="card flash" id="flashcard"><div class="learned-banner hidden" id="fcLearnedBadge"><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg><span>Đã thuộc</span></div><div class="flash-inner"><div class="flash-face flash-front"><div class="big" id="fcHanzi">—</div></div><div class="flash-face flash-back"><div class="front-peek" id="fcFrontPeek"></div><div class="pinyin" id="fcPinyin"></div><div class="hanviet" id="fcHanViet"></div><div class="meaning" id="fcMeaning"></div><div class="small" id="fcPos"></div><div class="mnemonic-wrap hidden" id="mnemonicWrap"></div></div></div></div><div class="card action-card"><div class="study-actions" id="studyActions"><button class="reveal-btn" id="btnReveal">Hiện đáp án <kbd>Space</kbd></button><div class="grade-actions" id="gradeRow"><button class="grade g-again" data-grade="again"><span>Lại</span><small id="ivAgain"></small></button><button class="grade g-hard" data-grade="hard"><span>Khó</span><small id="ivHard"></small></button><button class="grade g-good" data-grade="good"><span>Tốt</span><small id="ivGood"></small></button><button class="grade g-easy" data-grade="easy"><span>Dễ</span><small id="ivEasy"></small></button></div><div class="minor-actions"><button class="minor" id="btnPrev">← Lùi</button><button class="minor" id="btnNext">Tiếp →</button><button class="minor" id="btnShuffle"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="16 3 21 3 21 8"/><path d="M4 20L21 3"/><polyline points="21 16 21 21 16 21"/><path d="M15 15l6 6"/><path d="M4 4l5 5"/></svg><span>Xáo trộn</span></button></div></div></div></section>
<section id="history" class="section"><div class="card"><h3 style="margin-top:0">Các ngày đã học</h3><div id="historyList"></div></div><div class="card" id="historyDetailCard"><h3 style="margin-top:0">Bài ôn theo ngày <span id="historyCount" class="badge">0 từ</span></h3><div id="historyWords"><p class="small">Chọn một ngày để mở lại bài ôn.</p></div></div></section>
<section id="all" class="section"><div class="card"><input id="search" placeholder="Tìm Hán tự, pinyin, nghĩa..."/><div class="row" style="margin-top:10px"><select id="filter"><option value="all">Tất cả</option><option value="new">Chưa học</option><option value="learned">Đã học</option><option value="today">Trong bài hôm nay</option><option value="due">Đến hạn ôn</option></select></div><label class="checkline"><input id="selectVisible" type="checkbox"/> Chọn tất cả đang hiển thị <span id="visibleCount" class="badge">0 từ</span></label><div class="small" id="checkedCountRow" style="display:none;margin-bottom:6px">Đã chọn: <span id="checkedCount" class="badge">0</span></div><div class="list-actions"><button class="primary" id="btnAddSelected">Thêm vào hôm nay</button><button id="btnStudySelected">Học lại từ tick</button><button class="red" id="btnForgetSelected">Chuyển chưa học</button></div></div><div class="card" id="wordList"></div></section>
</main>
<button id="btnClearData" title="Xoá toàn bộ dữ liệu học (localStorage)" aria-label="Xoá dữ liệu"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg></button>
<script>
const VOCAB = [{"id":1,"hanzi":"去吃饭吧","pinyin":"qù chī fàn ba","meaning":"đi ăn cơm thôi","hanviet":"KHỨ NGẬT PHẠN BA","word":"吧","wpy":"ba","whv":"BA","wmean":"trợ từ (rủ rê, đề nghị)","pos":"吧 BA"},{"id":2,"hanzi":"不喝茶","pinyin":"bù hē chá","meaning":"không uống trà","hanviet":"BẤT HÁT TRÀ","word":"不","wpy":"bù","whv":"BẤT","wmean":"không","pos":"不 BẤT"},{"id":3,"hanzi":"真不客气","pinyin":"zhēn bú kèqi","meaning":"thật khách sáo (đáp 谢谢)","hanviet":"CHÂN BẤT KHÁCH KHÍ","word":"不客气","wpy":"bú kèqi","whv":"BẤT KHÁCH KHÍ","wmean":"không có gì","pos":"不客气 BẤT KHÁCH KHÍ"},{"id":4,"hanzi":"大家好","pinyin":"dàjiā hǎo","meaning":"chào mọi người","hanviet":"ĐẠI GIA HẢO","word":"大家","wpy":"dàjiā","whv":"ĐẠI GIA","wmean":"mọi người","pos":"大家 ĐẠI GIA"},{"id":5,"hanzi":"老师的书","pinyin":"lǎoshī de shū","meaning":"sách của giáo viên","hanviet":"LÃO SƯ ĐÍCH THƯ","word":"的","wpy":"de","whv":"ĐÍCH","wmean":"trợ từ sở hữu (của)","pos":"的 ĐÍCH"},{"id":6,"hanzi":"对不对","pinyin":"duì bú duì","meaning":"đúng không","hanviet":"ĐỐI BẤT ĐỐI","word":"对","wpy":"duì","whv":"ĐỐI","wmean":"đúng","pos":"对 ĐỐI"},{"id":7,"hanzi":"真对不起","pinyin":"zhēn duìbuqǐ","meaning":"thật xin lỗi","hanviet":"CHÂN ĐỐI BẤT KHỞI","word":"对不起","wpy":"duìbuqǐ","whv":"ĐỐI BẤT KHỞI","wmean":"xin lỗi","pos":"对不起 ĐỐI BẤT KHỞI"},{"id":8,"hanzi":"天气很好","pinyin":"tiānqì hěn hǎo","meaning":"thời tiết đẹp","hanviet":"THIÊN KHÍ NGẬN HẢO","word":"好","wpy":"hǎo","whv":"HẢO","wmean":"tốt, khỏe","pos":"好 HẢO"},{"id":9,"hanzi":"很忙","pinyin":"hěn máng","meaning":"rất bận","hanviet":"NGẬN MANG","word":"很","wpy":"hěn","whv":"NGẬN","wmean":"rất","pos":"很 NGẬN"},{"id":10,"hanzi":"好吃吗","pinyin":"hǎochī ma","meaning":"có ngon không","hanviet":"HẢO NGẬT MA","word":"吗","wpy":"ma","whv":"MA","wmean":"trợ từ nghi vấn (không?)","pos":"吗 MA"},{"id":11,"hanzi":"真没关系","pinyin":"zhēn méi guānxi","meaning":"thật không sao","hanviet":"CHÂN MỘT QUAN HỆ","word":"没关系","wpy":"méi guānxi","whv":"MỘT QUAN HỆ","wmean":"không sao","pos":"没关系 MỘT QUAN HỆ"},{"id":12,"hanzi":"没事了","pinyin":"méishì le","meaning":"không sao rồi","hanviet":"MỘT SỰ LIỄU","word":"没事","wpy":"méishì","whv":"MỘT SỰ","wmean":"không sao, không có việc gì","pos":"没事 MỘT SỰ"},{"id":13,"hanzi":"没有钱","pinyin":"méiyǒu qián","meaning":"không có tiền","hanviet":"MỘT HỮU TIỀN","word":"没有","wpy":"méiyǒu","whv":"MỘT HỮU","wmean":"không có","pos":"没有 MỘT HỮU"},{"id":14,"hanzi":"老师们","pinyin":"lǎoshī men","meaning":"các giáo viên","hanviet":"LÃO SƯ MÔN","word":"们","wpy":"men","whv":"MÔN","wmean":"hậu tố số nhiều","pos":"们 MÔN"},{"id":15,"hanzi":"写名字","pinyin":"xiě míngzi","meaning":"viết tên","hanviet":"TẢ DANH TỰ","word":"名字","wpy":"míngzi","whv":"DANH TỰ","wmean":"tên","pos":"名字 DANH TỰ"},{"id":16,"hanzi":"哪国人","pinyin":"nǎ guó rén","meaning":"người nước nào","hanviet":"NA QUỐC NHÂN","word":"哪","wpy":"nǎ","whv":"NA","wmean":"nào","pos":"哪 NA"},{"id":17,"hanzi":"要哪个","pinyin":"yào nǎge","meaning":"muốn cái nào","hanviet":"YẾU NA CÁ","word":"哪个","wpy":"nǎge","whv":"NA CÁ","wmean":"cái nào","pos":"哪个 NA CÁ"},{"id":18,"hanzi":"在哪里","pinyin":"zài nǎlǐ","meaning":"ở đâu","hanviet":"TẠI NA LÝ","word":"哪里","wpy":"nǎlǐ","whv":"NA LÝ","wmean":"ở đâu","pos":"哪里 NA LÝ"},{"id":19,"hanzi":"去哪儿","pinyin":"qù nǎr","meaning":"đi đâu","hanviet":"KHỨ NA NHI","word":"哪儿","wpy":"nǎr","whv":"NA NHI","wmean":"ở đâu","pos":"哪儿 NA NHI"},{"id":20,"hanzi":"哪些书","pinyin":"nǎxiē shū","meaning":"những quyển sách nào","hanviet":"NA TA THƯ","word":"哪些","wpy":"nǎxiē","whv":"NA TA","wmean":"những cái nào","pos":"哪些 NA TA"},{"id":21,"hanzi":"老师呢","pinyin":"lǎoshī ne","meaning":"còn giáo viên thì sao","hanviet":"LÃO SƯ NI","word":"呢","wpy":"ne","whv":"NI","wmean":"trợ từ (còn... thì sao)","pos":"呢 NI"},{"id":22,"hanzi":"你是谁","pinyin":"nǐ shì shéi","meaning":"bạn là ai","hanviet":"NHĨ THỊ THÙY","word":"你","wpy":"nǐ","whv":"NHĨ","wmean":"bạn, cậu","pos":"你 NHĨ"},{"id":23,"hanzi":"你好吗","pinyin":"nǐ hǎo ma","meaning":"bạn khỏe không","hanviet":"NHĨ HẢO MA","word":"你好","wpy":"nǐ hǎo","whv":"NHĨ HẢO","wmean":"xin chào","pos":"你好 NHĨ HẢO"},{"id":24,"hanzi":"你们好","pinyin":"nǐmen hǎo","meaning":"chào các bạn","hanviet":"NHĨ MÔN HẢO","word":"你们","wpy":"nǐmen","whv":"NHĨ MÔN","wmean":"các bạn","pos":"你们 NHĨ MÔN"},{"id":25,"hanzi":"您好吗","pinyin":"nín hǎo ma","meaning":"dạ bác khỏe không","hanviet":"NÊ HẢO MA","word":"您","wpy":"nín","whv":"NÊ","wmean":"ngài (kính ngữ)","pos":"您 NÊ"},{"id":26,"hanzi":"请喝茶","pinyin":"qǐng hē chá","meaning":"mời uống trà","hanviet":"THỈNH HÁT TRÀ","word":"请","wpy":"qǐng","whv":"THỈNH","wmean":"mời; xin","pos":"请 THỈNH"},{"id":27,"hanzi":"请问一下","pinyin":"qǐng wèn yíxià","meaning":"xin hỏi một chút","hanviet":"THỈNH VẤN NHẤT HẠ","word":"请问","wpy":"qǐngwèn","whv":"THỈNH VẤN","wmean":"xin hỏi","pos":"请问 THỈNH VẤN"},{"id":28,"hanzi":"谁的书","pinyin":"shéi de shū","meaning":"sách của ai","hanviet":"THÙY ĐÍCH THƯ","word":"谁","wpy":"shéi","whv":"THÙY","wmean":"ai","pos":"谁 THÙY"},{"id":29,"hanzi":"这是什么","pinyin":"zhè shì shénme","meaning":"đây là cái gì","hanviet":"GIÁ THỊ THẬP MA","word":"什么","wpy":"shénme","whv":"THẬP MA","wmean":"cái gì","pos":"什么 THẬP MA"},{"id":30,"hanzi":"是学生","pinyin":"shì xuéshēng","meaning":"là học sinh","hanviet":"THỊ HỌC SINH","word":"是","wpy":"shì","whv":"THỊ","wmean":"là","pos":"是 THỊ"},{"id":31,"hanzi":"他是老师","pinyin":"tā shì lǎoshī","meaning":"anh ấy là giáo viên","hanviet":"THA THỊ LÃO SƯ","word":"他","wpy":"tā","whv":"THA","wmean":"anh ấy","pos":"他 THA"},{"id":32,"hanzi":"它很小","pinyin":"tā hěn xiǎo","meaning":"nó rất nhỏ","hanviet":"THA NGẬN TIỂU","word":"它","wpy":"tā","whv":"THA","wmean":"nó (vật, con vật)","pos":"它 THA"},{"id":33,"hanzi":"她很漂亮","pinyin":"tā hěn piàoliang","meaning":"cô ấy rất xinh","hanviet":"THA NGẬN PHIÊU LƯỢNG","word":"她","wpy":"tā","whv":"THA","wmean":"cô ấy","pos":"她 THA"},{"id":34,"hanzi":"他们来了","pinyin":"tāmen lái le","meaning":"họ đến rồi","hanviet":"THA MÔN LAI LIỄU","word":"他们","wpy":"tāmen","whv":"THA MÔN","wmean":"họ (nam)","pos":"他们 THA MÔN"},{"id":35,"hanzi":"它们很小","pinyin":"tāmen hěn xiǎo","meaning":"chúng rất nhỏ","hanviet":"THA MÔN NGẬN TIỂU","word":"它们","wpy":"tāmen","whv":"THA MÔN","wmean":"chúng (vật)","pos":"它们 THA MÔN"},{"id":36,"hanzi":"她们来了","pinyin":"tāmen lái le","meaning":"họ (nữ) đến rồi","hanviet":"THA MÔN LAI LIỄU","word":"她们","wpy":"tāmen","whv":"THA MÔN","wmean":"họ (nữ)","pos":"她们 THA MÔN"},{"id":37,"hanzi":"喂，请说","pinyin":"wéi, qǐng shuō","meaning":"a lô, xin nói","hanviet":"ÚY THỈNH THUYẾT","word":"喂","wpy":"wèi","whv":"ÚY","wmean":"a lô (gọi điện)","pos":"喂 ÚY"},{"id":38,"hanzi":"我是学生","pinyin":"wǒ shì xuéshēng","meaning":"tôi là học sinh","hanviet":"NGÃ THỊ HỌC SINH","word":"我","wpy":"wǒ","whv":"NGÃ","wmean":"tôi","pos":"我 NGÃ"},{"id":39,"hanzi":"我们去","pinyin":"wǒmen qù","meaning":"chúng tôi đi","hanviet":"NGÃ MÔN KHỨ","word":"我们","wpy":"wǒmen","whv":"NGÃ MÔN","wmean":"chúng tôi","pos":"我们 NGÃ MÔN"},{"id":40,"hanzi":"谢谢老师","pinyin":"xièxie lǎoshī","meaning":"cảm ơn giáo viên","hanviet":"TẠ TẠ LÃO SƯ","word":"谢谢","wpy":"xièxie","whv":"TẠ TẠ","wmean":"cảm ơn","pos":"谢谢 TẠ TẠ"},{"id":41,"hanzi":"也喜欢","pinyin":"yě xǐhuan","meaning":"cũng thích","hanviet":"DÃ HỶ HOAN","word":"也","wpy":"yě","whv":"DÃ","wmean":"cũng","pos":"也 DÃ"},{"id":42,"hanzi":"明天再见","pinyin":"míngtiān zàijiàn","meaning":"mai gặp lại","hanviet":"MINH THIÊN TÁI KIẾN","word":"再见","wpy":"zàijiàn","whv":"TÁI KIẾN","wmean":"tạm biệt","pos":"再见 TÁI KIẾN"},{"id":43,"hanzi":"怎么去","pinyin":"zěnme qù","meaning":"đi thế nào","hanviet":"CHẨM MA KHỨ","word":"怎么","wpy":"zěnme","whv":"CHẨM MA","wmean":"thế nào, làm sao","pos":"怎么 CHẨM MA"},{"id":44,"hanzi":"怎么样了","pinyin":"zěnmeyàng le","meaning":"thế nào rồi","hanviet":"CHẨM MA DẠNG LIỄU","word":"怎么样","wpy":"zěnmeyàng","whv":"CHẨM MA DẠNG","wmean":"thế nào, ra sao","pos":"怎么样 CHẨM MA DẠNG"},{"id":45,"hanzi":"八点钟","pinyin":"bā diǎn zhōng","meaning":"tám giờ đúng","hanviet":"BÁT ĐIỂM CHUNG","word":"八","wpy":"bā","whv":"BÁT","wmean":"số tám (8)","pos":"八 BÁT"},{"id":46,"hanzi":"一百块","pinyin":"yìbǎi kuài","meaning":"một trăm đồ